# FitPlan-RAG 环境变量示例
# 复制本文件为 .env 并填入真实值（.env 不会被提交到 Git）

# 必填：阿里云 DashScope API Key
DASHSCOPE_API_KEY=

# 可选：DashScope OpenAI 兼容端点
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen3.7-flash
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
DASHSCOPE_RISK_MODEL=qwen3.7-flash

# 可选：重排（先配置 rerank 服务地址与模型）
FITPLAN_RAG_RERANK_ENABLED=false
FITPLAN_RAG_QUERY_REWRITE_ENABLED=true
DASHSCOPE_RERANK_BASE_URL=

# 可选：启动时重建索引（已有索引时保持 false）
FITPLAN_RAG_INDEX_ON_STARTUP=false

# 可选：启用 LLM 风险分类器（需先验证模型可用）
FITPLAN_RISK_CLASSIFIER_ENABLED=false

# 数据库（与 compose.yml 默认一致）
DB_URL=jdbc:postgresql://localhost:5432/fitplan
DB_USERNAME=fitplan
DB_PASSWORD=replace-with-a-strong-local-password

# Web 与管理端点。生产环境必须改成真实前端域名，禁止使用通配符。
FITPLAN_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
